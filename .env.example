# Variable names only. Copy to .env.local (git-ignored) and fill in local values. Never commit values.
APP_ENV=
DATABASE_URL=
TEST_DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
WORKER_DATABASE_URL=
TEST_WORKER_DATABASE_URL=
PUBLIC_BASE_URL=
API_PORT=
# Sign-in: base64 of 32 random bytes; encrypts TOTP secrets
TOTP_ENCRYPTION_KEY=
COOKIE_SECURE=
# Email (SMTP; Mailpit locally)
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_STARTTLS=
SMTP_USERNAME=
SMTP_PASSWORD=
# Object store (S3 API; MinIO locally)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=
# Client address (S08): proxies whose X-Forwarded-For is believed, comma-separated; empty = direct peer only
TRUSTED_PROXIES=
# Keep empty: the server itself must not rewrite the client address from proxy headers
FORWARDED_ALLOW_IPS=
